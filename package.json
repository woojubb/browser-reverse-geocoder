{
  "name": "browser-reverse-geocoder",
  "version": "1.0.1",
  "description": "A lightweight, browser-based reverse geocoding library using GeoJSON data",
  "main": "dist/browser-reverse-geocoder.umd.js",
  "module": "dist/browser-reverse-geocoder.es.js",
  "exports": {
    ".": {
      "import": "./dist/browser-reverse-geocoder.es.js",
      "require": "./dist/browser-reverse-geocoder.umd.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "readme.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "prepare": "husky"
  },
  "keywords": [
    "geocoding",
    "reverse geocoding",
    "geojson",
    "browser",
    "javascript"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "peerDependencies": {
    "@turf/bbox": "^7.0.0",
    "@turf/boolean-point-in-polygon": "^7.0.0",
    "rbush": "^3.0.1"
  },
  "dependencies": {
    "@turf/bbox": "^7.0.0",
    "@turf/boolean-point-in-polygon": "^7.0.0",
    "rbush": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "vite": "^8.0.7",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woojubb/browser-reverse-geocoder.git"
  },
  "bugs": {
    "url": "https://github.com/woojubb/browser-reverse-geocoder/issues"
  },
  "homepage": "https://github.com/woojubb/browser-reverse-geocoder#readme",
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix"
    ]
  }
}
